module(name = "repro")

bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13", is_default = True)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.13",
    uv_lock = "//:uv.lock",
    target_platforms = ["linux_aarch64", "linux_x86_64", "osx_aarch64"],
)
use_repo(pip, "python_deps")

bazel_dep(name = "platforms", version = "1.0.0")

bazel_dep(name = "rules_python_gazelle_plugin", version = "2.5.1")
