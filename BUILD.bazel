load("@python_deps//:requirements.bzl", "all_whl_requirements")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")

# What gazelle's python extension uses to map imports to pip packages.
modules_mapping(
    name = "modules_map",
    wheels = all_whl_requirements,
)

# Same thing with the macOS-only package filtered out by hand.
modules_mapping(
    name = "modules_map_workaround",
    wheels = [w for w in all_whl_requirements if "//appnope:" not in w],
)
